# ─────────────────────────────────────────────
# SahakarMitra .gitignore
# Prevents committing secrets, dependencies, local databases, and temporary files
# ─────────────────────────────────────────────

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Node dependencies
node_modules/
**/node_modules/

# Local databases & Vector store (ChromaDB)
chroma_data/
*.sqlite3
*.sqlite
*.db

# Production & Build outputs
dist/
**/dist/
build/
out/
.vite/

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE, Tools & Editor files
.rocketride/
.claude/
.vscode/
.idea/
*.swp
*.swo

# OS System Files
.DS_Store
Thumbs.db
