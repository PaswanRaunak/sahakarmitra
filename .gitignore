# ─────────────────────────────────────────────
# SahakarMitra .gitignore
# Prevents committing secrets, dependencies, local databases, and temporary files
# ─────────────────────────────────────────────

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Node dependencies
node_modules/
**/node_modules/

# Local databases, OCR traineddata & Vector cache
chroma_data/
.embeddings_cache.json
parents.json
parents-*.json
active-collection.json
citation-report.json
validation-results.json
manifest.json
review-scores.json
**/data/raw/
**/data/pending-ingestion/
**/data/updates/
**/data/updates-applied/
*.embeddings_cache.json
*.traineddata
*.sqlite3
*.sqlite
*.db

# Production & Build outputs
dist/
**/dist/
build/
out/
.vite/

# Logs & Diagnostics
*.log
*.jsonl
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE, Tools & Editor files
.rocketride/
.claude/
.gemini/
.vscode/
.idea/
.agents/
skills-lock.json
*.swp
*.swo

# OS System Files
.DS_Store
Thumbs.db
