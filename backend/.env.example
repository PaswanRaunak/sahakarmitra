# ─────────────────────────────────────────────
# SahakarMitra backend environment variables
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────

# ── OPTION A: OpenRouter (100% Free models available at https://openrouter.ai/keys)
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
# OPENROUTER_MODEL=google/gemini-2.0-flash-lite-preview-02-05:free
# (Other free models: meta-llama/llama-3.3-70b-instruct:free, deepseek/deepseek-r1:free)

# ── OPTION B: Groq API (Free tier at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ChromaDB server URL. Run ChromaDB locally with:
#   pip install chromadb
#   chroma run --path ./chroma_data --port 8000
CHROMA_URL=http://localhost:8000

# Port for the Express backend
PORT=5000

# Max relevance distance threshold for RAG retrieval (0 = exact match, 2 = opposite)
RELEVANCE_MAX_DISTANCE=1.6
