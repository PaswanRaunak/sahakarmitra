# ─────────────────────────────────────────────
# SahakarMitra backend environment variables
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────

# ── OPTION A: OpenRouter API (get key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# ── OPTION B: Groq API (get key from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ChromaDB server URL. Run ChromaDB locally with:
#   pip install chromadb
#   chroma run --path ./chroma_data --port 8000
CHROMA_URL=http://localhost:8000

# Port for the Express backend
PORT=5000

# Relevance cutoff for vector matching
RELEVANCE_MAX_DISTANCE=1.5
