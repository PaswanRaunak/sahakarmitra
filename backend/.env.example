# ─────────────────────────────────────────────
# SahakarMitra backend environment variables
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────

# ── OPTION A: OpenRouter API (get key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# ── OPTION B: Groq API (get key from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ChromaDB server URL. Run ChromaDB locally with:
#   pip install chromadb
#   chroma run --path ./chroma_data --port 8000
CHROMA_URL=http://localhost:8000

# Port for the Express backend
PORT=5000

# Relevance cutoff for vector matching
RELEVANCE_MAX_DISTANCE=1.5

# Max requests per IP per 15 min — raise this for bulk validation runs (validate:citations / validate:translations)
# RATE_LIMIT_MAX=500

# Scheduled legal-document monitoring (Module 2) — see scripts/scheduled-check.js
# ENABLE_CRON=true runs the scraper+diff inside the server process on CRON_SCHEDULE
# ENABLE_CRON=true
# CRON_SCHEDULE=0 3 * * *
# SCRAPER_REQUEST_GAP_MS=2000

# Blue-green reindex gate (npm run reindex)
# REINDEX_MIN_ACCURACY=0.9
# REINDEX_VALIDATE_LIMIT=0

# Telegram bot (npm run telegram-bot) — create a bot with @BotFather, paste its token
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
