# ─────────────────────────────────────────────
# SahakarMitra backend environment variables
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────

# Get a free Groq API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model id (free tier). Recommended:
#   llama-3.1-8b-instant  (fast, good for demos)
#   llama-3.1-70b-versatile (slower, smarter)
GROQ_MODEL=llama-3.3-70b-versatile

# ChromaDB server URL. Run ChromaDB locally with:
#   pip install chromadb
#   chroma run --path ./chroma_data --port 8000
CHROMA_URL=http://localhost:8000

# Port for the Express backend
PORT=5000

# Max relevance distance threshold for RAG retrieval (0 = exact match, 2 = opposite)
RELEVANCE_MAX_DISTANCE=1.6

